# Copy to .env and fill in from Supabase: Project Settings -> API Keys / Data API.
# The anon (or "publishable") key is safe to use in a browser; RLS protects the data.
# NEVER put the service_role / secret key in frontend code or commit it anywhere.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
